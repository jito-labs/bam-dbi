# Solana transaction signer and blockhash source
SOLANA_RPC_URL='https://api.mainnet-beta.solana.com'
PAYER_KEYPAIR='/absolute/path/to/funded-payer-keypair.json'
LAMPORTS='1'

# Optional: when omitted, the signed example transfers back to the payer.
# RECIPIENT='recipient-pubkey'

# JSON-RPC access
BAM_BUNDLE_URL='http://ewr.mainnet.bam.jito.wtf:9090/api/v1/bundles'
JITO_AUTH_UUID='replace-with-jito-provided-uuid'

# QUIC access; use a dedicated allowlisted keypair that does not hold SOL.
BAM_QUIC_ADDR='ewr.mainnet.bam.jito.wtf:11228'
BAM_QUIC_KEYPAIR='/absolute/path/to/allowlisted-quic-keypair.json'
